BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-output-from-openssl-rand-base64-32
ASBIR_DATA_DIR=./data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
ASBIR_MCP_ALLOWED_ORIGINS=
ASBIR_AUTH_BYPASS=0
# Google sign-in. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Company email domains that can sign up; new people from them pick a role and join the workspace.
ASBIR_ALLOWED_EMAIL_DOMAINS=lmf.ventures,plxrmedia.com
# Your team's name, shown in the sidebar. Used when the first person signs in on a new install.
ASBIR_COMPANY_NAME=Asbir Tech
# Slack app for direct messages about new versions and @mentions (scopes: chat:write, users:read, users:read.email).
SLACK_BOT_TOKEN=
