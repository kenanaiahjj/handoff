{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/capture-cleanup",
      "schedule": "0 17 * * *"
    }
  ],
  "installCommand": "cd ../.. && npm ci --workspaces --include-workspace-root"
}
