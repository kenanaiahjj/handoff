ASBIR_DOMAIN=handoff.example.com
BETTER_AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
ASBIR_MCP_ALLOWED_ORIGINS=

# Google sign-in: add https://<ASBIR_DOMAIN> and https://<ASBIR_DOMAIN>/api/auth/callback/google to the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Company email domains that can sign up.
ASBIR_ALLOWED_EMAIL_DOMAINS=lmf.ventures,plxrmedia.com
ASBIR_COMPANY_NAME=Asbir Tech
# Optional: Slack DMs for new versions and @mentions.
SLACK_BOT_TOKEN=
# Optional: continuous database backups (S3, Cloudflare R2, Backblaze B2...). See deploy/README.md.
LITESTREAM_REPLICA_URL=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Set per deploy (e.g. $(git rev-parse --short HEAD)) so open apps offer a reload.
ASBIR_BUILD_ID=
